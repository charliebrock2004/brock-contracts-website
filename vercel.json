{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "garage"
        }
      ],
      "destination": "/work/garage",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "sierras"
        }
      ],
      "destination": "/work/sierras",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "flooring-bridge-of-allan"
        }
      ],
      "destination": "/work/flooring-bridge-of-allan",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "new-build-perthshire"
        }
      ],
      "destination": "/work/new-build-perthshire",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "garage"
        }
      ],
      "destination": "/work/garage",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "sierras"
        }
      ],
      "destination": "/work/sierras",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "flooring-bridge-of-allan"
        }
      ],
      "destination": "/work/flooring-bridge-of-allan",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "new-build-perthshire"
        }
      ],
      "destination": "/work/new-build-perthshire",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/areas",
      "destination": "/areas.html"
    },
    {
      "source": "/building-work-crieff",
      "destination": "/building-work-crieff.html"
    },
    {
      "source": "/renovations",
      "destination": "/renovations.html"
    },
    {
      "source": "/joiner-crieff",
      "destination": "/joiner-crieff.html"
    },
    {
      "source": "/project",
      "destination": "/project.html"
    },
    {
      "source": "/work/garage",
      "destination": "/work/garage.html"
    },
    {
      "source": "/work/sierras",
      "destination": "/work/sierras.html"
    },
    {
      "source": "/work/flooring-bridge-of-allan",
      "destination": "/work/flooring-bridge-of-allan.html"
    },
    {
      "source": "/work/new-build-perthshire",
      "destination": "/work/new-build-perthshire.html"
    }
  ]
}
