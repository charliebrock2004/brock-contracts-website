{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "garage"
        }
      ],
      "destination": "/work/garage",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "sierras"
        }
      ],
      "destination": "/work/sierras",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "flooring-bridge-of-allan"
        }
      ],
      "destination": "/work/flooring-bridge-of-allan",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "new-build-perthshire"
        }
      ],
      "destination": "/work/new-build-perthshire",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "garage"
        }
      ],
      "destination": "/work/garage",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "sierras"
        }
      ],
      "destination": "/work/sierras",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "flooring-bridge-of-allan"
        }
      ],
      "destination": "/work/flooring-bridge-of-allan",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "new-build-perthshire"
        }
      ],
      "destination": "/work/new-build-perthshire",
      "permanent": true
    }
  ]
}
